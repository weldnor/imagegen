# Imagen backend configuration.
#
# Every setting is read from the environment only -- the backend reads no config
# file. Copy this file to `.env` (docker compose loads it automatically) and fill
# in the required values.
#
# Required variables have no default and the backend refuses to start without
# them. Optional variables show their default; omit them to accept it.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
#
# Values that can contain a literal "$" (bcrypt hashes, some API keys) are wrapped
# in single quotes so Docker Compose does not try to expand "$..." as a variable.
# Keep the quotes when you replace the samples.

# OpenRouter API key attached to every generation call. Never sent to the browser.
OPENROUTER_API_KEY='sk-or-REPLACE_ME'

# Telegram bot token from @BotFather. The bot is the only way to provision app
# users (via /adduser), so it must be configured for the deployment to be usable.
TELEGRAM_BOT_TOKEN='REPLACE_ME'

# Shared password gating the bot's /admin command (user management). Rotate by
# changing this and restarting.
ADMIN_PASSWORD='REPLACE_ME'

# PostgreSQL connection string.
DATABASE_URL=postgres://imagen:imagen@db:5432/imagen?sslmode=disable

# ---------------------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------------------

# Directory where generated image bytes are written. Must exist and be writable.
IMAGE_STORAGE_DIR=/data/images

# Address the HTTP server binds to.
LISTEN_ADDR=:8080

# How long a login session stays valid (Go duration string).
SESSION_TTL=720h

# Set to false to allow the session cookie over plain http (local dev only).
# MUST be true (the default) in any deployment that is not localhost.
SESSION_COOKIE_SECURE=false

# Name of the session cookie.
SESSION_COOKIE_NAME=imagen_session

# Maximum request body size for POST /api/generate, in bytes (32 MiB). 413 past it.
MAX_UPLOAD_BYTES=33554432

# Maximum number of concurrent OpenRouter calls per generation batch.
OPENROUTER_CONCURRENCY=4

# Per-image upstream timeout (Go duration string).
OPENROUTER_TIMEOUT=120s

# OpenRouter API base URL. Override only for testing.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Serve the frontend from this directory instead of the binary's embedded copy.
# Leave unset to use the embedded frontend.
# STATIC_DIR=
